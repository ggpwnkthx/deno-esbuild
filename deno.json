{
  "workspace": [
    "./packages/esbuild",
    "./packages/plugins/deno",
    "./packages/plugins/css",
    "./packages/wrappers/shared",
    "./packages/wrappers/hono",
    "./packages/wrappers/oak"
  ],
  "nodeModulesDir": "none",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true
  },
  "imports": {
    "@std/cli": "jsr:@std/cli@^1.0.32",
    "@std/encoding": "jsr:@std/encoding@^1.0.11",
    "@std/path": "jsr:@std/path@^1.1.6",
    "@std/semver": "jsr:@std/semver@^1.0.8"
  },
  "fmt": {
    "lineWidth": 100,
    "semiColons": false,
    "singleQuote": true
  },
  "lint": {
    "rules": {
      "tags": [
        "recommended"
      ]
    }
  },
  "exclude": [
    "./.*"
  ],
  "tasks": {
    "ci": "deno fmt --check && deno lint && deno check",
    "bin:build": "deno run --allow-read --allow-write --allow-run=git,go --allow-env scripts/main.ts",
    "bin:list": "deno run --allow-read scripts/main.ts --list"
  }
}
