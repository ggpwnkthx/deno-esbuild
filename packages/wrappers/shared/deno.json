{
  "name": "@ggpwnkthx/esbuild-wrapper-shared",
  "version": "0.3.1",
  "exports": "./mod.ts",
  "imports": {
    "esbuild": "jsr:@ggpwnkthx/esbuild@^0.2.14",
    "@deno/graph": "jsr:@deno/graph@^0.110.2",
    "@std/assert": "jsr:@std/assert@^1.0.19"
  },
  "publish": {
    "include": [
      "mime.ts",
      "mod.ts",
      "rewrite_imports.ts",
      "router.ts",
      "README.md",
      "LICENSE.md",
      "deno.json"
    ]
  },
  "tasks": {
    "fmt": "deno fmt .",
    "lint": "deno lint .",
    "check": "deno check .",
    "test": "deno test --allow-read --allow-write",
    "ci": "deno fmt --check && deno lint && deno check && deno test --allow-read --allow-write"
  }
}
