{
  "name": "@ggpwnkthx/esbuild-wrapper-hono",
  "version": "0.2.10",
  "exports": {
    ".": "./mod.ts",
    "./wasm": "./transpilers/wasm.ts"
  },
  "imports": {
    "@ggpwnkthx/esbuild-wrapper-shared": "jsr:@ggpwnkthx/esbuild-wrapper-shared@^0.2.10",
    "esbuild": "jsr:@ggpwnkthx/esbuild@^0.2.14",
    "hono": "jsr:@hono/hono@^4.12.32",
    "@std/assert": "jsr:@std/assert@^1.0.19"
  },
  "publish": {
    "include": [
      "mod.ts",
      "transpilers/wasm.ts",
      "README.md",
      "LICENSE.md",
      "deno.json"
    ]
  },
  "tasks": {
    "fmt": "deno fmt .",
    "lint": "deno lint .",
    "check": "deno check .",
    "test": "deno test --allow-read --allow-write --allow-env --allow-run --allow-net=github.com,release-assets.githubusercontent.com,jsr.io",
    "ci": "deno fmt --check && deno lint && deno check && deno test --allow-read --allow-write --allow-env --allow-run --allow-net=github.com,release-assets.githubusercontent.com,jsr.io"
  }
}
