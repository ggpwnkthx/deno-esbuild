{
  "name": "@ggpwnkthx/esbuild",
  "version": "0.2.11",
  "exports": {
    ".": "./mod.ts",
    "./wasm": "./wasm.ts",
    "./shared/common": "./shared/common.ts",
    "./shared/stdio_protocol": "./shared/stdio_protocol.ts",
    "./shared/types": "./shared/types.ts",
    "./shared/uint8array_json_parser": "./shared/uint8array_json_parser.ts",
    "./shared/worker": "./shared/worker.ts"
  },
  "publish": {
    "include": [
      "mod.ts",
      "wasm.ts",
      "binary_installer.ts",
      "shared/",
      "README.md",
      "LICENSE.md",
      "deno.json"
    ]
  },
  "tasks": {
    "fmt": "deno fmt .",
    "lint": "deno lint .",
    "check": "deno check .",
    "test": "deno test --allow-read --allow-write --allow-env --allow-net --allow-run",
    "ci": "deno fmt --check && deno lint && deno check && deno test --allow-read --allow-write --allow-env --allow-net --allow-run"
  }
}
