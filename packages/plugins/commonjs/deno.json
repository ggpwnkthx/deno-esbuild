{
  "name": "@ggpwnkthx/esbuild-plugin-commonjs",
  "version": "0.1.1",
  "exports": {
    ".": "./mod.ts"
  },
  "imports": {
    "acorn": "npm:acorn@^8.14.0",
    "astring": "npm:astring@^1.9.0",
    "esbuild": "jsr:@ggpwnkthx/esbuild@^0.2.16",
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@std/path": "jsr:@std/path@^1.1.6"
  },
  "publish": {
    "include": [
      "mod.ts",
      "transform.ts",
      "README.md",
      "CHANGELOG.md",
      "LICENSE.md",
      "deno.json"
    ]
  },
  "tasks": {
    "fmt": "deno fmt .",
    "lint": "deno lint .",
    "check": "deno check .",
    "test": "deno test -A",
    "ci": "deno task fmt && deno task lint && deno task check && deno task test"
  }
}
