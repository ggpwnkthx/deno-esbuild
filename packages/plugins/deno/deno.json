{
  "name": "@ggpwnkthx/esbuild-plugin-deno",
  "version": "0.3.0",
  "exports": {
    ".": "./mod.ts"
  },
  "imports": {
    "esbuild": "jsr:@ggpwnkthx/esbuild@^0.2.12",
    "@deno/graph": "jsr:@deno/graph@^0.110.2",
    "@deno/loader": "jsr:@deno/loader@^0.5.0",
    "@std/path": "jsr:@std/path@^1.1.6",
    "@std/assert": "jsr:@std/assert@^1.0.19"
  },
  "publish": {
    "include": [
      "mod.ts",
      "utils.ts",
      "graph.ts",
      "path.ts",
      "rewrite.ts",
      "assets.ts",
      "unbundle.ts",
      "README.md",
      "LICENSE.md",
      "deno.json"
    ]
  },
  "tasks": {
    "fmt": "deno fmt .",
    "lint": "deno lint .",
    "check": "deno check .",
    "test": "deno test --allow-read --allow-write --allow-env --allow-net --allow-run",
    "ci": "deno fmt --check && deno lint && deno check && deno test --allow-read --allow-write --allow-env --allow-net --allow-run"
  }
}
